rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
   
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function isSuper() { return signedIn() && role() == 'super'; }
    function isSchoolAdmin(schoolId) { return signedIn() && role() == 'admin' && request.auth.token.schoolId == schoolId; }
    function sameSchool(schoolId) { return signedIn() && request.auth.token.schoolId == schoolId; }
    function unchanged(fields) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields); }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isMe(uid) || isSuper() || isSchoolAdmin(resource.data.schoolId);
      allow create: if isMe(uid) && request.resource.data.role == 'student'
        && request.resource.data.greenPoints == 0 && request.resource.data.verified == false;
      allow update: if (isMe(uid) && unchanged(['role','schoolId','greenPoints','verified','locked','badges']))
        || isSchoolAdmin(resource.data.schoolId) && unchanged(['role','schoolId','greenPoints'])
        || isSuper();
      allow delete: if isSuper();
    }

    match /schools/{id} {
      allow read: if signedIn();
      allow write: if isSuper();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if isSuper() || (signedIn() && role() == 'admin');
    }

    match /items/{id} {
      allow read: if signedIn() && sameSchool(resource.data.schoolId) || isSuper();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && sameSchool(request.resource.data.schoolId)
        && request.resource.data.status == 'Available'
        && request.resource.data.images.size() <= 5
        && request.resource.data.name is string && request.resource.data.name.size() >= 3;

      allow update: if (resource.data.ownerId == request.auth.uid && unchanged(['ownerId','schoolId','status']))
        || isSchoolAdmin(resource.data.schoolId) || isSuper();
      allow delete: if resource.data.ownerId == request.auth.uid || isSchoolAdmin(resource.data.schoolId) || isSuper();
    }


    match /borrowRequests/{id} {
      allow read: if signedIn() && (resource.data.borrowerId == request.auth.uid
        || resource.data.ownerId == request.auth.uid || isSchoolAdmin(resource.data.schoolId)) || isSuper();
      allow create: if signedIn() && request.resource.data.borrowerId == request.auth.uid
        && request.resource.data.status == 'Pending' && request.resource.data.ownerId != request.auth.uid;
      allow update, delete: if false;
    }


    match /transactions/{id} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants
        || isSchoolAdmin(resource.data.schoolId)) || isSuper();
      allow write: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if false;
    }

    // Đánh giá: một lần cho mỗi giao dịch & người đánh giá (ID = txId_reviewerId); điều kiện "đã hoàn tất" kiểm tra trong Function
    match /reviews/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && id == request.resource.data.transactionId + '_' + request.auth.uid
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read: if signedIn() && resource.data.reporterId == request.auth.uid
        || isSchoolAdmin(resource.data.schoolId) || isSuper();
      allow update: if isSchoolAdmin(resource.data.schoolId) || isSuper();
      allow delete: if false;
    }

    match /favorites/{id} {
      allow read, write: if signedIn() && (resource == null ? request.resource.data.userId : resource.data.userId) == request.auth.uid;
    }
    match /needs/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid || isSuper();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /pointsHistory/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isSchoolAdmin(resource.data.schoolId)) || isSuper();
      allow write: if false;
    }
  }
}
